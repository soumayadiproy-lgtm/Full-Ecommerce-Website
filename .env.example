# Environment Variables for Vercel Deployment
# Copy this to .env for local development, or set in Vercel Dashboard for production

MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/ecommerce
JWT_SECRET=your-strong-secret-key-change-this
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Google Gemini AI - Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 📧 REAL EMAIL VERIFICATION (Gmail SMTP or custom SMTP)
# 1. Enter your Gmail address:
EMAIL_USER=your-email@gmail.com
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Optional custom SMTP overrides (leave empty if using Gmail):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
