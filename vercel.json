{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "public/**"
    },
    "index.js": {
      "includeFiles": "public/**"
    },
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}
