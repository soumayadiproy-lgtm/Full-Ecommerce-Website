{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "{public/**,data/**}"
    },
    "index.js": {
      "includeFiles": "{public/**,data/**}"
    },
    "api/index.js": {
      "includeFiles": "{public/**,data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}
